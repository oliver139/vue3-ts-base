{
  "name": "vue3-ts-base",
  "type": "module",
  "version": "4.0.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "description": "A nice template for starting a VueTS project",
  "author": "Oliver Mak",
  "license": "MIT",
  "homepage": "https://github.com/oliver139/vue3-ts-base",
  "repository": {
    "type": "git",
    "url": "github:oliver139/vue3-ts-base"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "rimraf auto-imports.d.ts components.d.ts",
    "dev": "vite",
    "prepare": "simple-git-hooks",
    "build": "run-p \"build-only {@}\" type-check --",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "check": "nr type-check",
    "lint": "eslint --cache",
    "lint:fix": "eslint --cache --fix",
    "lint:inspect": "eslint --inspect-config",
    "analyze": "nlx node-modules-inspector",
    "release": "nlx bumpp",
    "ncu": "nlx npm-check-updates"
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.3",
    "@vueuse/core": "^14.2.1",
    "pinia": "^3.0.4",
    "primevue": "^4.5.4",
    "tailwindcss-primeui": "^0.6.1",
    "vue": "^3.5.30",
    "vue-i18n": "^11.3.0",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@antfu/ni": "^28.3.0",
    "@iconify/vue": "^5.0.0",
    "@oliver139/eslint-config": "^5.1.0",
    "@primevue/auto-import-resolver": "^4.5.4",
    "@tsconfig/node24": "^24.0.4",
    "@types/eslint-plugin-tailwindcss": "^3.17.0",
    "@types/node": "^25.4.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vue/tsconfig": "^0.9.0",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.0.3",
    "eslint-plugin-tailwindcss": "^3.18.2",
    "lint-staged": "^16.3.3",
    "npm-run-all2": "^8.0.4",
    "postcss": "^8.5.8",
    "postcss-hexrgba": "^2.1.0",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^31.0.0",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.7",
    "vue-tsc": "^3.2.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --cache --fix"
  },
  "browserslist": [
    ">0.3%",
    "defaults",
    "last 5 versions",
    "last 10 Chrome versions",
    "not dead"
  ]
}
