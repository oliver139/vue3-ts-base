{
  "name": "vue3-ts-base",
  "type": "module",
  "version": "4.0.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "description": "A nice template for starting a VueTS project",
  "author": "Oliver Mak",
  "license": "MIT",
  "homepage": "https://github.com/oliver139/vue3-ts-base",
  "repository": {
    "type": "git",
    "url": "github:oliver139/vue3-ts-base"
  },
  "engines": {
    "node": "^24.18.1",
    "runtime": {
      "name": "node",
      "version": "^24.18.1",
      "onFail": "download"
    }
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.18.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.25.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "predev": "rimraf auto-imports.d.ts components.d.ts",
    "dev": "vite",
    "prepare": "simple-git-hooks",
    "build": "run-s build-only type-check",
    "build-only": "vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --build --force",
    "check": "nr type-check",
    "lint": "eslint --cache",
    "lint:fix": "eslint --cache --fix",
    "lint:inspect": "eslint --inspect-config",
    "analyze": "nlx node-modules-inspector",
    "release": "nlx bumpp",
    "ncu": "nlx npm-check-updates"
  },
  "dependencies": {
    "@nuxt/ui": "^4.11.0",
    "@vueuse/core": "^14.4.0",
    "@vueuse/router": "^14.4.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.9",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@antfu/ni": "^30.5.0",
    "@iconify/vue": "^5.0.1",
    "@oliver139/eslint-config": "^7.7.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tsconfig/node24": "^24.0.5",
    "@types/eslint-plugin-tailwindcss": "^3.17.0",
    "@types/node": "^25.9.5",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.1",
    "eslint-plugin-better-tailwindcss": "~4.6.0",
    "lint-staged": "^17.3.0",
    "npm-run-all2": "^9.0.3",
    "postcss": "^8.5.26",
    "postcss-hexrgba": "^2.1.0",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vue-tsc": "^3.3.11"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --cache --fix"
  },
  "browserslist": [
    ">0.3%",
    "defaults",
    "last 5 versions",
    "last 10 Chrome versions",
    "not dead"
  ]
}
